{
  "$schema": "https://typedoc.org/schema.json",
  "name": "versioned-store",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core",
    "packages/prompt-store",
    "packages/scaffold-store",
    "packages/cli"
  ],
  "out": "docs-site",
  "readme": "README.md",
  "projectDocuments": [
    "docs/status.md",
    "docs/guide/consuming.md",
    "docs/guide/operating.md",
    "docs/guide/backends.md",
    "docs/migration/alpha.5-to-beta.6.md",
    "docs/migration/beta.6-to-beta.7.md"
  ],
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "navigationLinks": {
    "GitHub": "https://github.com/baabakk/versioned-store",
    "npm": "https://www.npmjs.com/org/versioned-store"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}
