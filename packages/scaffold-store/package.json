{
  "name": "@versioned-store/scaffold-store",
  "version": "0.1.0-alpha.5",
  "description": "A batteries-included, versioned scaffold store with a deterministic promote-gate (pinning + placeholder-binding + executable allowlist), built on @versioned-store/core. Version, gate, and roll back your project scaffolds.",
  "type": "module",
  "author": "Babak",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baabakk/versioned-store.git",
    "directory": "packages/scaffold-store"
  },
  "homepage": "https://github.com/baabakk/versioned-store/tree/main/packages/scaffold-store#readme",
  "bugs": "https://github.com/baabakk/versioned-store/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scaffold",
    "scaffolding",
    "project-template",
    "boilerplate",
    "generator",
    "versioned-config",
    "eval-gate",
    "monorepo"
  ],
  "dependencies": {
    "@versioned-store/core": "^0.1.0-alpha.5"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
